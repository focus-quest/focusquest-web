---
import { SHOW_APP_STORE_LINK, APP_STORE_HREF } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const here = Astro.url.pathname;
function nav(href: string) {
  const full = base.replace(/\/$/, '') + href;
  return here === full || here === full + '/';
}
---
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href={base}>
      <img class="brand-icon" src={`${base}icon.png`} alt="" />
      <span>FocusQuest</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href={`${base}privacy`} aria-current={nav('/privacy') ? 'page' : undefined}>Privacy</a>
      <a href={`${base}terms`} aria-current={nav('/terms') ? 'page' : undefined}>Terms</a>
      <a href={`${base}support`} aria-current={nav('/support') ? 'page' : undefined}>Support</a>
    </nav>
    <div class="nav-tools">
      <button class="icon-btn" id="theme-toggle" aria-label="Toggle theme">
        <svg id="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>
      {SHOW_APP_STORE_LINK && (
        <a class="download-btn" href={APP_STORE_HREF} aria-label="Download on the App Store">
          <svg viewBox="0 0 814 1000" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <span class="label">App Store</span>
        </a>
      )}
    </div>
  </div>
</header>
<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = root.getAttribute('data-theme') === 'dark';
    root.setAttribute('data-theme', dark ? 'light' : 'dark');
    localStorage.setItem('fq-theme', dark ? 'light' : 'dark');
  });
</script>
