---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const here = Astro.url.pathname;
function nav(href: string) {
  const full = base.replace(/\/$/, '') + href;
  return here === full || here === full + '/';
}
---
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href={base}>
      <span class="brand-dot" aria-hidden="true"></span>
      <span>Focus Quest</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a href={`${base}privacy`} aria-current={nav('/privacy') ? 'page' : undefined}>Privacy</a>
      <a href={`${base}terms`} aria-current={nav('/terms') ? 'page' : undefined}>Terms</a>
      <a href={`${base}support`} aria-current={nav('/support') ? 'page' : undefined}>Support</a>
    </nav>
    <div class="nav-tools">
      <button class="icon-btn" id="theme-toggle" aria-label="Toggle theme">
        <svg id="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      </button>
      <a class="download-btn" href="#" aria-label="Download on the App Store">
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M17.05 12.04c-.03-2.7 2.21-4 2.31-4.06-1.26-1.84-3.22-2.1-3.92-2.13-1.66-.17-3.25 1-4.1 1-.85 0-2.16-.97-3.55-.95-1.83.03-3.51 1.06-4.45 2.7-1.9 3.29-.49 8.16 1.36 10.83.9 1.31 1.97 2.78 3.36 2.73 1.35-.05 1.86-.87 3.5-.87s2.1.87 3.53.84c1.46-.02 2.38-1.33 3.27-2.65 1.03-1.51 1.46-2.98 1.49-3.06-.03-.01-2.85-1.09-2.88-4.32z"/></svg>
      <span class="label">App Store</span>
      </a>
    </div>
  </div>
</header>
<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = root.getAttribute('data-theme') === 'dark';
    root.setAttribute('data-theme', dark ? 'light' : 'dark');
    localStorage.setItem('fq-theme', dark ? 'light' : 'dark');
  });
</script>
