---
interface Props { effective: string; updated: string; }
const { effective, updated } = Astro.props;
const showEffective = effective && effective !== updated;
---
<div class="last-updated-block">
  <div class="last-updated">
    <span class="dot"></span>
    <span>Updated <b>{updated}</b></span>
  </div>
  {showEffective && <div class="effective-note">Effective {effective}</div>}
</div>
