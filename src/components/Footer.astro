---
import { SHOW_APP_STORE_LINK, APP_STORE_HREF } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer>
  <div class="foot-inner">
    <div class="foot-brand">
      <div class="brand"><span class="brand-dot" aria-hidden="true"></span><span>Focus Quest</span></div>
      <div style="line-height:1.55; color:var(--ink-mute)">A focus app for adventurers. Built solo in Berlin.</div>
    </div>
    <div class="foot-cols">
      <div class="foot-col">
        <h4>App</h4>
        <a href={base}>Overview</a>
        {SHOW_APP_STORE_LINK && <a href={APP_STORE_HREF}>Download on App Store</a>}
      </div>
      <div class="foot-col">
        <h4>Help</h4>
        <a href={`${base}support`}>Support</a>
        <a href={`${base}faq`}>FAQ</a>
        <a href="mailto:kaumon.business@gmail.com">Contact</a>
      </div>
      <div class="foot-col">
        <h4>Legal</h4>
        <a href={`${base}privacy`}>Privacy</a>
        <a href={`${base}terms`}>Terms</a>
        <a href={`${base}impressum`}>Impressum</a>
      </div>
    </div>
    <div class="foot-fine">
      <span>© 2026 Kaumon Aung · Berlin, Germany</span>
      {SHOW_APP_STORE_LINK && <span>Apple, the Apple logo, and App Store are trademarks of Apple Inc.</span>}
    </div>
  </div>
</footer>
