---
import { SHOW_APP_STORE_LINK, APP_STORE_HREF } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer>
  <div class="foot-inner">
    <div class="foot-brand">
      <div class="brand">
        <img class="brand-icon" src={`${base}icon.png`} alt="" />
        <span>FocusQuest</span>
      </div>
      <div style="line-height:1.55; color:var(--ink-mute)">A focus app for adventurers.</div>
    </div>
    <div class="foot-cols">
      <div class="foot-col">
        <h4>App</h4>
        <a href={base}>Overview</a>
        {SHOW_APP_STORE_LINK && <a href={APP_STORE_HREF}>Download on App Store</a>}
      </div>
      <div class="foot-col">
        <h4>Help</h4>
        <a href={`${base}support`}>Support</a>
        <a href={`${base}faq`}>FAQ</a>
        <a href="mailto:support@example.com">Contact</a>
      </div>
      <div class="foot-col">
        <h4>Legal</h4>
        <a href={`${base}privacy`}>Privacy</a>
        <a href={`${base}terms`}>Terms</a>
        <a href={`${base}impressum`}>Impressum</a>
      </div>
    </div>
    <div class="foot-fine">
      <span>© 2026 Kaumon Aung · Made with <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="love"><path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg> in Berlin</span>
      {SHOW_APP_STORE_LINK && <span>Apple, the Apple logo, and App Store are trademarks of Apple Inc.</span>}
    </div>
  </div>
</footer>
