---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SHOW_APP_STORE_LINK, APP_STORE_HREF } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// App Store preview panels (public/screenshots/*.webp — 828×1792).
// Panel 01 leads the hero; panels 02–08 become alternating feature rows.
// Each panel already carries its own baked-in headline + subhead, so the
// `eyebrow`/`title`/`body` here ADD concrete detail rather than repeat it.
const features = [
  {
    src: '02-quest-board.webp',
    alt: 'Pick a quest, press start — a daily quest board of focus sessions with XP and gold rewards.',
    eyebrow: 'Quests',
    title: 'A board that fits the focus you’ve got',
    body: 'Every day brings a fresh set of quests — quick 10-minute errands, classic 25-minute Pomodoros, or epic multi-session campaigns. Each pays out XP and gold scaled to the effort.',
  },
  {
    src: '03-timer.webp',
    alt: 'Every focused minute moves you forward — the hero journeys through a snowy biome as the timer runs.',
    eyebrow: 'The session',
    title: 'Start it, then forget it',
    body: 'Once a quest begins there’s nothing to fiddle with. Your hero walks the landscape on their own while the timer runs — so you can put the phone down and do the actual work.',
  },
  {
    src: '04-finished-quest.webp',
    alt: 'Finish focused and earn XP, gold and gear — a Quest Complete rewards screen.',
    eyebrow: 'Rewards',
    title: 'Concentration that compounds',
    body: 'Finish a session and you’re paid in XP, gold, and the occasional piece of gear. Bank the win, then line up another quest or head back to the tavern.',
  },
  {
    src: '05-character-tab.webp',
    alt: 'Level up a hero that grows with you — a character screen with collectible armor and stats.',
    eyebrow: 'Your hero',
    title: 'Spend what you earn',
    body: 'Turn gold into armor and equipment, level up your adventurer, and switch between classes. The more you focus, the stronger your character gets.',
  },
  {
    src: '06-activity.webp',
    alt: "Build a streak you won't want to break — an activity dashboard with focus history and focus-type breakdown.",
    eyebrow: 'Your progress',
    title: 'The receipts on your focus',
    body: 'A contribution-style heatmap, running streaks, guild achievements, and a breakdown of where your hours actually go — study, code, design, writing. Momentum you can see.',
  },
  {
    src: '07-group-quest.webp',
    alt: 'Focus together with friends — a real-time group quest with several heroes in a desert biome.',
    eyebrow: 'Guild quests',
    title: 'Focus is better with a party',
    body: 'Start a guild quest and focus alongside friends in real time — everyone’s hero shares the same journey. A little accountability that keeps you all honest, never at the cost of a friend’s progress.',
  },
  {
    src: '08-soundscape.webp',
    alt: 'Calming worlds made for deep work — a pixel-art biome with an ambient soundscape picker.',
    eyebrow: 'Atmosphere',
    title: 'Pick a world to disappear into',
    body: 'Five hand-drawn pixel-art biomes, each with its own ambient soundscape — from a cursed forest to haunted ruins. Calm, looping, and built to fade into the background.',
  },
];
---
<BaseLayout title="FocusQuest — a focus app for adventurers">
  <section class="page hero">
    <div class="hero-copy">
      <div class="hero-eyebrow"><span class="pip"></span> A focus app for adventurers</div>
      <h1 class="hero-title">Turn focus sessions into quests.</h1>
      <p class="hero-lede">FocusQuest is a pixel-art productivity RPG for iOS. Pick a quest, choose your biome, and let your character journey across scrolling landscapes while you work. Earn XP, gold, and armor — never at the cost of a friend's progress.</p>
      <div class="hero-cta">
        {SHOW_APP_STORE_LINK && (
          <a class="btn-primary" href={APP_STORE_HREF}>
            <svg viewBox="0 0 814 1000" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
            Download on the App Store
          </a>
        )}
        <a class="btn-secondary" href="#preview">See it in action →</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-cluster">
        <img class="hc hc-back hc-back-l" src={`${base}screenshots/02-quest-board.webp`} alt="" aria-hidden="true" width="828" height="1792" decoding="async" />
        <img class="hc hc-back hc-back-r" src={`${base}screenshots/03-timer.webp`} alt="" aria-hidden="true" width="828" height="1792" decoding="async" />
        <img
          class="hc hc-front"
          src={`${base}screenshots/01-hero.webp`}
          alt="Your focus timer is now an adventure — a hero quests across a pixel-art forest while you work."
          width="828"
          height="1792"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="features" id="preview" aria-labelledby="features-title">
    <div class="features-head">
      <div class="hero-eyebrow"><span class="pip"></span> Inside the app</div>
      <h2 class="features-title" id="features-title">A pixel-art world for getting things done.</h2>
      <p class="features-sub">Every screen, from picking a quest to the world you focus in.</p>
    </div>
    {features.map((f) => (
      <article class="feature">
        <div class="feature-visual">
          <img
            src={`${base}screenshots/${f.src}`}
            alt={f.alt}
            width="828"
            height="1792"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="feature-copy">
          <div class="feature-eyebrow">{f.eyebrow}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-body">{f.body}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="home-grid">
    <a class="home-card" href={`${base}privacy`}>
      <div class="card-eyebrow">Legal</div>
      <h3>Privacy Policy</h3>
      <p>What we collect, how we use it, and the rights you have. No analytics, no ads, no tracking.</p>
      <span class="arrow">Read the policy →</span>
    </a>
    <a class="home-card" href={`${base}terms`}>
      <div class="card-eyebrow">Legal</div>
      <h3>Terms &amp; Conditions</h3>
      <p>The agreement between you and FocusQuest. Subscription details, acceptable use, and the usual fine print.</p>
      <span class="arrow">Read the terms →</span>
    </a>
    <a class="home-card" href={`${base}support`}>
      <div class="card-eyebrow">Help</div>
      <h3>Support</h3>
      <p>Account deletion, subscription help, bug reports, and how to reach me directly.</p>
      <span class="arrow">Get help →</span>
    </a>
  </section>
</BaseLayout>
