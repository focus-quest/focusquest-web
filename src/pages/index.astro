---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SHOW_APP_STORE_LINK, APP_STORE_HREF } from '../consts';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title="FocusQuest — a focus app for adventurers">
  <section class="page hero">
    <div class="hero-eyebrow"><span class="pip"></span> A focus app for adventurers</div>
    <h1 class="hero-title">Turn focus sessions into quests.</h1>
    <p class="hero-lede">FocusQuest is a pixel-art productivity RPG for iOS. Pick a quest, choose your biome, and let your character journey across scrolling landscapes while you work. Earn XP, gold, and armor — never at the cost of a friend's progress.</p>
    <div class="hero-cta">
      {SHOW_APP_STORE_LINK && (
        <a class="btn-primary" href={APP_STORE_HREF}>
          <svg viewBox="0 0 814 1000" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          Download on the App Store
        </a>
      )}
      <a class="btn-secondary" href={`${base}support`}>Get support →</a>
    </div>
  </section>
  <section class="home-grid">
    <a class="home-card" href={`${base}privacy`}>
      <div class="card-eyebrow">Legal</div>
      <h3>Privacy Policy</h3>
      <p>What we collect, how we use it, and the rights you have. No analytics, no ads, no tracking.</p>
      <span class="arrow">Read the policy →</span>
    </a>
    <a class="home-card" href={`${base}terms`}>
      <div class="card-eyebrow">Legal</div>
      <h3>Terms &amp; Conditions</h3>
      <p>The agreement between you and FocusQuest. Subscription details, acceptable use, and the usual fine print.</p>
      <span class="arrow">Read the terms →</span>
    </a>
    <a class="home-card" href={`${base}support`}>
      <div class="card-eyebrow">Help</div>
      <h3>Support</h3>
      <p>Account deletion, subscription help, bug reports, and how to reach me directly.</p>
      <span class="arrow">Get help →</span>
    </a>
  </section>
</BaseLayout>
